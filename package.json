{
  "name": "quiet-relay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local Nostr policy workbench with verifiable, replayable evidence.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4326 --strictPort",
    "relay": "tsx server/relay.ts",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4326 --strictPort",
    "test": "tsx --test tests/*.test.ts",
    "replay": "tsx scripts/replay.ts",
    "verify": "tsx scripts/verify.ts",
    "package": "node scripts/package.mjs",
    "format": "prettier --write src server tests scripts docs README.md package.json tsconfig.json vite.config.ts index.html"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "lucide-react": "^0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "ws": "8.21.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/ws": "^8.0.0",
    "nostr-tools": "2.25.2",
    "prettier": "3.9.8",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
